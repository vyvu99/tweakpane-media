{
	"name": "tweakpane-media",
	"version": "0.1.6",
	"description": "Image and video inputs for Tweakpane 4",
	"type": "module",
	"license": "MIT",
	"author": "vyvu",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/vyvu99/tweakpane-media.git"
	},
	"keywords": [
		"tweakpane",
		"tweakpane-plugin",
		"image",
		"video",
		"media",
		"drag-drop",
		"threejs"
	],
	"sideEffects": false,
	"main": "./dist/tweakpane-media.js",
	"module": "./dist/tweakpane-media.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/tweakpane-media.js"
		}
	},
	"files": [
		"dist"
	],
	"packageManager": "pnpm@10.33.2",
	"engines": {
		"node": ">=20"
	},
	"peerDependencies": {
		"tweakpane": "^4.0.0"
	},
	"scripts": {
		"build": "vite build && tsc -p tsconfig.build.json",
		"check": "biome check . && tsc --noEmit",
		"fix": "biome check --write .",
		"test": "vitest run --maxWorkers=2",
		"changeset": "changeset",
		"release": "pnpm check && pnpm test && pnpm build && changeset publish",
		"example": "vite examples"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.3",
		"@changesets/cli": "^3.0.3",
		"jsdom": "^30.1.3",
		"tweakpane": "^4.0.5",
		"typescript": "^7.0.2",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	},
	"dependencies": {
		"@tweakpane/core": "^2.0.5"
	},
	"homepage": "https://github.com/vyvu99/tweakpane-media#readme",
	"bugs": {
		"url": "https://github.com/vyvu99/tweakpane-media/issues"
	}
}
